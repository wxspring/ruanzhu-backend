# ============================================
# 软著材料 AI 生产系统 - 环境变量配置
# ============================================
# 复制此文件为 .env 并修改相应配置：
# cp .env.example .env

# ---------- 数据库 (MySQL) ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ruanzhu
MYSQL_USER=root
MYSQL_PASSWORD=123456
# ↑ L9 MYSQL_PORT=3306 之前在 L13 又重复定义了一次，导致 spring-dotenv 抛 duplicate key 异常启动失败；已删除重复行

# ---------- 缓存 (Redis) ----------
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# ---------- 对象存储 (MinIO) ----------
# ⚠️ 变量命名要跟 application*.yml 里的占位符严格对齐：
#   application.yml 用 ${MINIO_HOST}/${MINIO_PORT}/${MINIO_ROOT_USER}/${MINIO_ROOT_PASSWORD}/${MINIO_BUCKET}
#   application-prod.yml 用 ${MINIO_ENDPOINT}/${MINIO_ACCESS_KEY}/${MINIO_SECRET_KEY}
#   这里把两套命名都写上，避免再出现 "Could not resolve placeholder 'MINIO_PORT'" 这种启动失败。
MINIO_ENDPOINT=http://localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin@123456
MINIO_BUCKET=ruanzhu-system

# ---------- 后端 (Spring Boot) ----------
BACKEND_PORT=8080
JWT_SECRET=Ki4DP9md6QBTE7oMngTFtbmKf6PZVIYiT9zpUqfuP6duIX5P0TMs6ipjyn+LuHxesw1oiw67P8QKVT4KcZAtLg==
JWT_EXPIRATION=86400000
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC

# ---------- 前端 (nginx) ----------
FRONTEND_PORT=80

# ---------- AI 服务 (至少配置一个) ----------
# OpenAI
OPENAI_API_KEY=
# 通义千问
QWEN_API_KEY=
#Deepseek
DEEPSEEK_API_KEY=sk-73cadf49c07f4399ac58aae814ff14d7
