# ============================================
# 软著材料 AI 生产系统 - 环境变量配置
# ============================================
# 复制此文件为 .env 并修改相应配置：
# cp .env.example .env

# ---------- 数据库 (MySQL) ----------
MYSQL_ROOT_PASSWORD=root_password_here
MYSQL_DATABASE=ruanzhu
MYSQL_USER=ruanzhu
MYSQL_PASSWORD=ruanzhu_password_here
MYSQL_PORT=3306

# ---------- 缓存 (Redis) ----------
REDIS_PASSWORD=redis_password_here
REDIS_PORT=6379

# ---------- 对象存储 (MinIO) ----------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin_password_here
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=ruanzhu-system

# ---------- 后端 (Spring Boot) ----------
BACKEND_PORT=8080
JWT_SECRET=your-jwt-secret-must-be-at-least-256-bits-long-for-hs256-algorithm
JWT_EXPIRATION=86400000
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC

# ---------- 前端 (nginx) ----------
FRONTEND_PORT=80

# ---------- AI 服务 (至少配置一个) ----------
# OpenAI
OPENAI_API_KEY=
# 通义千问
QWEN_API_KEY=
